    def arata_despre(self):
        ver = "1.0.8 (local)"
        for cmd in (
            ["dpkg-query", "-W", "-f=${Version}", "Mplayer_personal"],
            ["rpm", "-q", "--qf", "%{VERSION}", "Mplayer_personal"],
            ["pacman", "-Q", "Mplayer_personal"]
        ):
            try:
                out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()
                if out:
                    ver = out.split()[-1]
                    break
            except Exception:
                pass

        msg = QMessageBox(self)
        msg.setWindowTitle(self.tr("about_title"))
        msg.setTextFormat(Qt.TextFormat.RichText)
        msg.setText(
            f"<h3>Player Video & Audio Personal</h3>"
            f"<p><b>Versiune instalată:</b> {ver}</p>"
            f"<p>Motor multimedia: <b>libmpv</b> + <b>PyQt6</b></p>"
            f"<p>Dezvoltat și personalizat de <b>Gbagape</b> &copy; {datetime.now().year}</p>"
        )

        cai_posibile = [
            "/usr/share/icons/hicolor/256x256/apps/mmp-player-despre.png",
            os.path.join(getattr(sys, "_MEIPASS", ""), "mmp-player-despre.png"),
            os.path.expanduser("~/pachet-player/usr/share/icons/hicolor/256x256/apps/mmp-player-despre.png")
        ]
        ico_despre = next((p for p in cai_posibile if p and os.path.exists(p)), None)

        if ico_despre:
            pix = QPixmap(ico_despre).scaled(96, 96, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            msg.setIconPixmap(pix)
        else:
            msg.setIcon(QMessageBox.Icon.Information)

        msg.exec()


    def deschide_url(self):
        clip = QApplication.clipboard().text().strip()
        text_initial = clip if clip.startswith(("http://", "https://")) else ""
        url, ok = QInputDialog.getText(self, self.tr("tt_url"), self.tr("dlg_url_lbl"), text=text_initial)
        if ok and url.strip():
            link = url.strip()
            self.ultimul_playlist = [link]
            self.fisier_curent = link
            self.player.command("playlist-clear")
            self.player.command("loadfile", link, "replace")
            self.player.pause = False
            self.setWindowTitle("Stream URL - MMP Player")
            self.dock_titlu.setText(link)
            self.adauga_in_playlist(tuple((url.strip(),)))

    def incarca_setari(self):
        s = dict(SETARI_IMPLICITE)
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    s.update(json.load(f))
            except Exception: pass
        return s

    def salveaza_setari(self):
        os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(self.setari, f, indent=2)

    def aplica_skin(self, nume):
        self.setari["tema"] = nume
        self.salveaza_setari()
        if nume not in ("dark", "blue", "light"): nume = "light"; self.setari["tema"] = "light"
        if True:
            self.consola.hide()
            self.sm_dock.show()
        else:
            self.sm_dock.hide()
            ordine = {"bsplayer": 0, "xine": 1, "winamp": 2}
            self.consola.stack.setCurrentIndex(ordine.get(nume, 0))
            self.consola.adjustSize()
            if not self.isFullScreen():
                self.consola.show()

    def schimba_skin_rapid(self):
        toate = ("dark", "blue", "light")
        curent = self.setari.get("tema", "light")
        idx = (toate.index(curent) + 1) % len(toate) if curent in toate else 0
        nume = toate[idx]
        self.setari["tema"] = nume
        self.salveaza_setari()
        self.aplica_skin(nume)
    def aplica_stil_subtitrare(self):
        s = self.setari
        alpha_hex = f"{int(s.get('sub_opacitate', 255)):02X}"

        def cu_opacitate(hex_rgb):
            return f"#{alpha_hex}{hex_rgb.lstrip('#')}"

        self.player.sub_codepage = s.get("sub_codare", "cp1250")
        self.player.sub_auto = s.get("sub_auto", "all")
        self.player.sid = "auto" if s.get("sub_select_first", True) else "no"
        self.player.sub_ass = bool(s.get("sub_use_ass", True))
        if s.get("sub_autodetect", False):
            self.player.sub_auto_detect = True
            self.player.slang = s.get("sub_lang", "ro,rum,ron")
        else:
            self.player.sub_auto_detect = False
        self.player.sub_ass_override = "force" if s.get("sub_ass_force", False) else "yes"

        if not s.get("sub_custom", True):
            return

        self.player.sub_font = s.get("sub_font", "Arial")
        self.player.sub_font_size = s.get("sub_marime", 40)
        self.player.sub_bold = bool(s.get("sub_bold", False))
        self.player.sub_italic = bool(s.get("sub_italic", False))
        self.player.sub_pos = s.get("sub_pozitie", 100)
        self.player.sub_color = cu_opacitate(s.get("sub_culoare", "#FFFFFF"))

        stil = s.get("sub_stil_chenar", "contur")
        if stil == "banda":
            self.player.sub_border_style = "opaque-box"
            self.player.sub_back_color = cu_opacitate(s.get("sub_culoare_chenar", "#000000"))
            self.player.sub_border_size = 2
            self.player.sub_shadow_offset = 0
        elif stil == "fara":
            self.player.sub_border_style = "outline-and-shadow"
            self.player.sub_border_size = 0
            self.player.sub_shadow_offset = 0
        else:
            self.player.sub_border_style = "outline-and-shadow"
            self.player.sub_border_color = cu_opacitate(s.get("sub_culoare_chenar", "#000000"))
            self.player.sub_shadow_color = cu_opacitate(s.get("sub_culoare_umbra", "#000000"))
            self.player.sub_border_size = 3
            self.player.sub_shadow_offset = 2

    def deschide_preferinte(self):
        dlg = FereastraPreferinte(self, self.setari)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.setari = dlg.setari
            self.salveaza_setari()
            self.aplica_skin(self.setari["tema"])
            self.aplica_stil_subtitrare()               # <--- ÎNLOCUIEȘTE vechile linii sub_font_size / sub_color / sub_pos cu aceasta!
            self.player.volume = self.setari["volum_implicit"]

    def deschide_preferinte(self):
        dlg = FereastraPreferinte(self, self.setari)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.setari = dlg.setari
            self.salveaza_setari()
            self.aplica_skin(self.setari["tema"])
            self.player.sub_font = self.setari["sub_font"]
            self.player.sub_font_size = self.setari["sub_marime"]
            self.player.sub_color = self.setari["sub_culoare"]
            self.player.sub_pos = self.setari["sub_pozitie"]
            self.player.volume = self.setari["volum_implicit"]

    def adauga_in_playlist(self, fisiere):
        self.salveaza_pozitia_curenta()
        self.ultimul_playlist = list(fisiere)
        self.fisier_curent = self.ultimul_playlist[0] if self.ultimul_playlist else None
        self.player.command("playlist-clear")
        for idx, f in enumerate(fisiere):
            nume = os.path.basename(f)
            self.player.command("loadfile", f, "replace" if idx == 0 else "append")
        if fisiere:
            nume = os.path.basename(next(iter(fisiere)))
            self.setWindowTitle(f"{nume} - MMP Player")
            self.dock_titlu.setText(nume)

    def deschide_fisiere(self):
        fisiere, _ = QFileDialog.getOpenFileNames(
            self, "Alege fisier(e)", self.setari["folder_implicit"],
            "Media (*.mp4 *.mkv *.avi *.mov *.webm *.flv *.wmv *.ogv *.mp3 *.ogg *.oga *.opus *.flac .mid* .midi* *.wav);;Toate (*)"
        )
        if fisiere: self.adauga_in_playlist(fisiere)

    def deschide_folder(self):
        folder = QFileDialog.getExistingDirectory(self, self.tr("dlg_dir_title"), self.setari["folder_implicit"])
        if folder:
            ext = (
                ".mp4", ".mkv", ".avi", ".mov", ".webm", ".flv", ".wmv", ".ogv",
                ".mp3", ".ogg", ".oga", ".opus", ".flac", ".wav", ".m4a", ".mid", ".midi"
            )
            fisiere = [os.path.join(folder, f) for f in sorted(os.listdir(folder)) if f.lower().endswith(ext)]
            if fisiere: 
                self.adauga_in_playlist(fisiere)

    def incarca_subtitrare(self):
        sub, _ = QFileDialog.getOpenFileName(self, self.tr("dlg_sub_title"), self.setari["folder_implicit"], "Subtitrari (*.srt *.sub *.ass *.vtt)")
        if sub: self.player.sub_add(sub)

    def anterior_sigur(self):
        try:
            count = self.player.playlist_count or 0
            pos = self.player.playlist_pos or 0
            if count > 1 and pos > 0:
                self.player.command("playlist-prev")
            else:
                self.player.command("seek", 0, "absolute")
        except Exception:
            pass

    def urmator_sigur(self):
        try:
            count = self.player.playlist_count or 0
            pos = self.player.playlist_pos or 0
            if count > 1 and pos < count - 1:
                self.player.command("playlist-next")
            else:
                self.player.command("seek", 60)
        except Exception:
            pass

    def stop_sigur(self):
        self.player.command("stop")
        self.player.pause = True
        self.oprit_manual = True
        self.dock_t1.setText("00:00:00")
        self.consola.cl_timp.setText("00:00:00")
        for sl in (self.consola.cl_seek, self.dock_seek):
            sl.setValue(0)

    def toggle_play(self):
        # Dacă a fost oprit cu Stop sau playlist-ul e gol, reîncarcă ultimul fișier/playlist/URL de la 00:00:00
        if getattr(self, "oprit_manual", False) or self.player.idle_active:
            lista = getattr(self, "ultimul_playlist", [])
            if lista:
                self.oprit_manual = False
                self.player.command("playlist-clear")
                for i, item in enumerate(lista):
                    self.player.command("loadfile", item, "replace" if i == 0 else "append")
                self.player.pause = False
                return
        self.player.pause = not self.player.pause

    def toggle_fullscreen(self):
        if self.isFullScreen():
            self.menuBar().show()
            self.tb.show()
            self.showNormal()
            self.aplica_skin(self.setari.get("tema", "light"))
        else:
            self.menuBar().hide()
            self.tb.hide()
            self.sm_dock.hide()
            self.consola.hide()
            self.showFullScreen()

    def _incepe_mutare_fereastra(self, event):
        if self.isFullScreen():
            return
        if self.isMaximized():
            self.showNormal()
            self._win_drag_offset = QPoint(self.width() // 2, self.height() // 2)
        if self._win_drag_offset is not None:
            self.move(event.globalPosition().toPoint() - self._win_drag_offset)

    def eventFilter(self, obj, event):
        if obj is getattr(self, "video_frame", None):
            etype = event.type()
            if etype == event.Type.MouseButtonPress and event.button() == Qt.MouseButton.LeftButton:
                gpos = event.globalPosition().toPoint()
                self._win_drag_start = gpos
                self._win_drag_offset = gpos - self.pos()
                self._win_dragging = False
                return True
            elif etype == event.Type.MouseMove and (event.buttons() & Qt.MouseButton.LeftButton):
                if self._win_drag_start is not None:
                    gpos = event.globalPosition().toPoint()
                    if (gpos - self._win_drag_start).manhattanLength() >= 6:
                        self._win_dragging = True
                        self._incepe_mutare_fereastra(event)
                return True
            elif etype == event.Type.MouseButtonRelease and event.button() == Qt.MouseButton.LeftButton:
                self._win_drag_start = None
                self._win_drag_offset = None
                self._win_dragging = False
                return True
            elif etype == event.Type.MouseButtonDblClick and event.button() == Qt.MouseButton.LeftButton:
                self._win_drag_start = None
                self._win_drag_offset = None
                self._win_dragging = False
                self.toggle_fullscreen()
                return True
        return super().eventFilter(obj, event)

    def mouseDoubleClickEvent(self, event):
        self.toggle_fullscreen()

    def deruleaza(self, val):
        try:
            dur = self.player.duration
            if dur and dur > 0:
                tinta = (val / 1000.0) * dur
                self.player.command("seek", tinta, "absolute+keyframes")
        except Exception:
            pass

    def format_timp(self, s):
        if s is None: return "00:00:00"
        s = int(s)
        return f"{s // 3600:02d}:{(s % 3600) // 60:02d}:{s % 60:02d}"

    def actualizeaza_interfata(self):
        try:
            pos, dur = self.player.time_pos, self.player.duration
        except Exception:
            return
        if pos is not None and dur is not None and dur > 0:
            t_pos, t_dur = self.format_timp(pos), self.format_timp(dur)
            val = int((pos / dur) * 1000)
            self.consola.cl_timp.setText(t_pos)
            self.consola.cl_dur.setText(t_dur)
            self.dock_t1.setText(t_pos)
            self.dock_t2.setText(t_dur)
            for sl in (self.consola.cl_seek, self.dock_seek):
                if not sl.isSliderDown(): sl.setValue(val)

    def keyPressEvent(self, event):
        k = event.key()
        if k == Qt.Key.Key_X: self.stop_sigur()
        elif k == Qt.Key.Key_F: self.toggle_fullscreen()
        elif k == Qt.Key.Key_N: self.deschide_url()
        elif k in (Qt.Key.Key_Plus, Qt.Key.Key_Equal): self.player.sub_font_size = (self.player.sub_font_size or 40) + 4
        elif k == Qt.Key.Key_Minus: self.player.sub_font_size = max(16, (self.player.sub_font_size or 40) - 4)
        elif k == Qt.Key.Key_R: self.player.sub_pos = max(10, int(self.player.sub_pos or 100) - 2)
        elif k == Qt.Key.Key_T: self.player.sub_pos = min(100, int(self.player.sub_pos or 100) + 2)
        elif k == Qt.Key.Key_Escape and self.isFullScreen(): self.toggle_fullscreen()
        elif k == Qt.Key.Key_Up:
            vol = min(130, int(self.player.volume or 85) + 5)
            self.player.volume = vol
            self.dock_vol.setValue(vol)
            self.player.show_text(self.tr("osd_vol").format(vol=vol), 1000)
        elif k == Qt.Key.Key_Down:
            vol = max(0, int(self.player.volume or 85) - 5)
            self.player.volume = vol
            self.dock_vol.setValue(vol)
            self.player.show_text(self.tr("osd_vol").format(vol=vol), 1000)
        elif k == Qt.Key.Key_M:
            self.player.mute = not self.player.mute
            self.player.show_text(self.tr("osd_mute_on") if self.player.mute else self.tr("osd_mute_off"), 1000)

    def wheelEvent(self, event):
        delta = event.angleDelta().y()
        if delta == 0:
            return

        # Dacă ții apăsat Ctrl + Rotiță -> reglează volumul
        if event.modifiers() & Qt.KeyboardModifier.ControlModifier:
            pas = 5 if delta > 0 else -5
            vol = max(0, min(130, int(self.player.volume or 85) + pas))
            self.player.volume = vol
            self.dock_vol.setValue(vol)
            self.player.show_text(self.tr("osd_vol").format(vol=vol), 1000)
        # Rotiță simplă -> derulează înainte / înapoi cu 5 secunde
        else:
            sec = 10 if delta > 0 else -10
            try:
                self.player.command("seek", sec)
                pos = self.player.time_pos or 0
                dur = self.player.duration or 0
                self.player.show_text(self.tr("osd_seek").format(pos=self.format_timp(pos), dur=self.format_timp(dur)), 1200)
            except Exception:
                pass

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        urls = [u.toLocalFile() for u in event.mimeData().urls() if u.isLocalFile()]
        ext_media = (
            ".mp4", ".mkv", ".avi", ".mov", ".webm", ".flv", ".wmv", ".ogv",
            ".mp3", ".ogg", ".oga", ".opus", ".flac", ".wav", ".m4a", ".mid", ".midi"
        )
        ext_sub = (".srt", ".sub", ".ass", ".vtt")

        fisiere_media = [f for f in urls if f.lower().endswith(ext_media)]
        fisiere_sub = [f for f in urls if f.lower().endswith(ext_sub)]

        if fisiere_media:
            self.adauga_in_playlist(sorted(fisiere_media))
            self.player.pause = False
        for sub in fisiere_sub:
            self.player.sub_add(sub)


    def incarca_pozitii(self):
        if os.path.exists(self.fisier_pozitii):
            try:
                with open(self.fisier_pozitii, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
        return {}

    def salveaza_pozitia_curenta(self):
        if not self.setari.get("memoreaza_pozitia", True) or not self.fisier_curent:
            return
        try:
            pos = self.player.time_pos
            dur = self.player.duration
            if pos and dur and dur > 30:
                if pos / dur > 0.95:
                    self.pozitii_salvate.pop(self.fisier_curent, None)
                else:
                    self.pozitii_salvate[self.fisier_curent] = pos
                os.makedirs(os.path.dirname(self.fisier_pozitii), exist_ok=True)
                with open(self.fisier_pozitii, "w", encoding="utf-8") as f:
                    json.dump(self.pozitii_salvate, f, indent=2)
        except Exception:
            pass

    def ascunde_cursor_fs(self):
        if self.isFullScreen():
            self.setCursor(Qt.CursorShape.BlankCursor)

    def mouseMoveEvent(self, event):
        self.unsetCursor()
        if self.isFullScreen():
            self.timer_cursor.start()
        super().mouseMoveEvent(event)

    def closeEvent(self, event):
        self.consola.close()
        self.player.terminate()
        event.accept()

